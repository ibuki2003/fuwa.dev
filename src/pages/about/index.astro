---
import Layout from "@/layouts/default.astro";
import { Image } from "astro:assets";
import { CodeXml, Cpu, ShieldCheck, MonitorActivity } from '@lucide/astro';

const links = [
  [
    import("./_icons/github.svg"),
    "GitHub@ibuki2003",
    "https://github.com/ibuki2003",
  ],
  [
    import("./_icons/qiita.svg"),
    "Qiita@ibuki2003",
    "https://qiita.com/ibuki2003",
  ],
  [import("./_icons/zenn.svg"), "Zenn@fuwa2003", "https://zenn.dev/fuwa2003"],
  [
    import("./_icons/twitter.svg"),
    "Twitter@ibuki2003",
    "https://twitter.com/ibuki2003",
  ],
  [
    import("./_icons/misskey_io.svg"),
    "@fuwa2003@misskey.io",
    "https://misskey.io/@fuwa2003",
  ],
  [
    import("./_icons/orcid.svg"),
    "ORCiD Ibuki Sugiyama",
    "https://orcid.org/0009-0007-5896-5621",
  ],
  [
    import("./_icons/keybase.png"),
    "keybase@fuwa2003",
    "https://keybase.io/fuwa2003",
  ],
  [
    "https://img.shields.io/endpoint?url=https%3A%2F%2Fatcoder-badges.now.sh%2Fapi%2Fatcoder%2Fjson%2Fibuki2003",
    "AtCoder@ibuki2003",
    "https://atcoder.jp/users/ibuki2003",
  ],
] as const;
---

<Layout title="About Me">
  <article class="main">
    <section id="personal_info">
      <img class="profilePic" src="/assets/fuwa.svg" alt="" />
      <div>
        <h2>杉山 衣吹 (にこなのにふわわあ)</h2>
        <p>Ibuki Sugiyama</p>
        <table id="profile_table">
          <tbody>
            <tr>
              <th>Affiliation</th>
              <td>
                東京大学 (理学部 情報科学科)
                <br />
                The University of Tokyo
                <br />
                (B4, 2027/03 卒業予定)
                <br />
                <a href="https://sites.google.com/view/casys-ja/">CASYS</a>
              </td>
            </tr>
            <tr>
              <th>Date of Birth</th>
              <td>2003-04-26</td>
            </tr>
            <tr>
              <th>OpenPGP Key</th>
              <td>
                <a href="https://fuwa.dev/fuwa.asc">
                  <code class="pgpKey">
                    <span>B9C6</span>
                    <span>B4B0</span>
                    <span>956F</span>
                    <span>BAE9</span>
                    <span>456E</span>
                    <span>2B38</span>
                    <span>615E</span>
                    <span>83E8</span>
                    <span>4465</span>
                    <span>1088</span>
                  </code>
                </a>
              </td>
            </tr>
            <tr>
              <th>Call sign</th>
              <td>JJ1FYD</td>
            </tr>
          </tbody>
        </table>

        <div class="links">
          <ul class="linkIcons">
            {
              links
                .filter((a) => a[0])
                .map(([icon, alt, href]) => (
                  <li>
                    <a href={href} rel="me">
                      {icon instanceof Promise ? (
                        <Image
                          src={icon as Promise<{ default: ImageMetadata }>}
                          alt={alt}
                          title={alt}
                        />
                      ) : (
                        <img src={icon} alt={alt} title={alt} />
                      )}
                    </a>
                  </li>
                ))
            }
          </ul>
        </div>
      </div>
    </section>
    <section class="profile-section">
      <h2>Timeline</h2>
      <ol class="timeline">
        {
          (
            [
              ["2016/04", "APCC入部"],
              ["2020/11", "パソコン甲子園2020 グランプリ (ひよこなめくじ)"],
              ["2022/03", "麻布高等学校 卒業"],
              ["2022/04", "東京大学 入学"],
              ["2026/10", "CASYS 卒論配属"],
            ] as const
          ).map(([date, detail]) => (
            <li class="timelineEntry">
              <span class="date">{date}</span>
              <span class="detail">{detail}</span>
            </li>
          ))
        }
        <li class="timelineEntry now" aria-hidden="true"></li>
        <li class="timelineEntry future">
          <span class="date">2027/03</span>
          <span class="detail">東京大学 卒業予定</span>
        </li>
        <li class="timelineEntry future">
          <span class="date">2027/04</span>
          <span class="detail">東京大学大学院 情報理工学系研究科 進学予定</span>
        </li>
      </ol>
    </section>
    <section class="profile-section">
      <h2>Expertise</h2>
      <div class="expertise">
        <section class="expertise-card">
          <h3><MonitorActivity aria-hidden="true" />Computer Systems</h3>
          <ul>
            <li>OSやネットワークの理解</li>
            <li>Linuxシステムの構築・運用</li>
            <li>仮想化・コンテナを用いた環境構築</li>
          </ul>
          <ul class="pills">
            <li>Linux</li>
            <li>systemd</li>
            <li>Docker</li>
            <li>Proxmox</li>
          </ul>
        </section>
        <section class="expertise-card">
          <h3><CodeXml aria-hidden="true" />Software Development</h3>
          <ul>
            <li>アーキテクチャ設計</li>
            <li>Web Apps (backend, frontend)</li>
            <li>CLI</li>
            <li>System Apps</li>
          </ul>
          <ul class="pills">
            <li>Rust</li>
            <li>HTML</li>
            <li>TypeScript</li>
          </ul>
        </section>
        <section class="expertise-card">
          <h3><Cpu aria-hidden="true" />Electronics</h3>
          <ul>
            <li>電子工作</li>
            <li>組込みシステム開発</li>
            <li>無線通信・信号処理</li>
          </ul>
          <ul class="pills">
            <li>RP2350</li>
            <li>KiCad</li>
            <li>RF</li>
          </ul>
        </section>
        <section class="expertise-card">
          <h3><ShieldCheck aria-hidden="true" />Qualifications</h3>
          <ul>
            <li>応用情報技術者試験 (AP)</li>
            <li>第一級アマチュア無線技士</li>
          </ul>
        </section>
      </div>
    </section>
    <section class="profile-section">
      <h2>Works</h2>
      <div class="works">
        {
          [
            {
              title: "麻布学園 文化祭管理システムCAPPUCCINO",
              date: "2020/12〜2021/11",
              href: "https://zenn.dev/su8ru/articles/cappuccino-system",
              description:
                "感染症対策のため来場者の入退場数を管理するシステム。麻布学園の第74回文化祭にて使用。",
            },
            {
              title: "PSkey",
              date: "2023/07〜",
              href: "https://github.com/ibuki2003/pskey",
              description: (
                <>
                  <a href="https://github.com/misskey-dev/pskey">Misskey</a>
                  のAndroidクライアント
                </>
              ),
            },
            {
              title: "MorseCord",
              date: "2023/07〜",
              href: "https://github.com/ibuki2003/morsecord",
              description: "モールス符号聞き取り練習のためのDiscord Bot",
            },
            {
              title: "Fuwa Online Judge",
              date: "2017/10 ～ 2020/10",
              href: "https://github.com/ibuki2003/onlinejudge",
              description:
                "競技プログラミングのためのオンラインジャッジシステム。中高の部内で使用",
            },
          ].map(({ title, date, href, description }) => (
            <div class="works-entry">
              <h3>
                <a href={href}>{title}</a>
              </h3>
              <p class="description">{description}</p>
              <p class="date">{date}</p>
            </div>
          ))
        }
      </div>
      <p><a href="https://github.com/ibuki2003">And more at GitHub</a></p>
    </section>
    <section class="profile-section">
      <h2>More information</h2>
      <ul>
        <li>
          <a href="/about/equipments/">Equipments</a>
        </li>
      </ul>
    </section>
  </article>
</Layout>

<style lang="scss">
  section.main:not(:last-child) {
    margin-bottom: 3rem;
  }

  section#personal_info {
    display: flex;
    place-content: center;
    border: 1px solid var(--fg1);
    border-radius: 0.6rem;

    img.profilePic {
      background: #fff;
      height: 15rem;
      width: 15rem;
      border: 1px solid var(--fg1);
      margin-left: 1rem;
      margin-right: 2rem;
      margin-top: auto;
      margin-bottom: auto;
    }

    table {
      width: 100%;
      margin-top: 1rem;

      tr {
        background: transparent !important;
        border: none;

        th {
          border-right: 1px solid var(--fg1);
          text-align: right;
          width: 40%;
        }
      }

      &#profile_table tr {
        height: 2.5em;
      }
    }

    .pgpKey span:not(:last-child):after {
      content: " ";
    }

    .links {
      width: fit-content;
      margin-left: auto;

      a {
        text-decoration: none;
      }

      img {
        height: 1.2em;
        width: auto;
      }

      .linkIcons {
        padding-left: 0;
        margin-top: 2rem;
        text-align: right;

        li {
          display: inline;
          margin-right: 1rem;
          margin-bottom: 1rem;
        }
      }
    }
  }

  @media screen and (max-width: 500px) {
    section#personal_info {
      display: block;
      img.profilePic {
        width: 100%;
        height: auto;
        margin: 0 !important;
      }
    }
  }

  .profile-section {
    margin-top: 2.5rem;

    > h2 {
      padding: 0 0 0.65rem 0.85rem;
      border-left: 4px solid #4384f2;
      border-bottom: 1px solid var(--bg2);
      background: none;
      &::after { display: none; } // remove the default underline
    }
  }

  .expertise {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;

    /* @media (max-width: 1000px) { grid-template-columns: repeat(2, minmax(0, 1fr)); } */
    @media (max-width: 500px) { grid-template-columns: minmax(0, 1fr); }

    .expertise-card {
      display: flex;
      flex-direction: column;
      padding: 1.25rem;
      border: 1px solid var(--bg2);
      border-radius: 0.75rem;
      background: rgba(var(--bg1-rgb), 0.4);

      h3 {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin: 0 0 0.5rem;
        padding: 0;
        border: none;
        font-size: 1rem;
        line-height: 1.5;

        svg {
          width: 1.6rem;
          height: 1.6rem;
          flex-shrink: 0;
          color: #4384f2;
        }
      }

      &>* {
        margin: 0.5rem 0 0;
      }

      ul.pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.5rem 0 0;
        margin: auto 0 0;
        list-style: none;

        li {
          padding: 0.2rem 0.65rem;
          border-radius: 1rem;
          background: var(--bg2);
          font-size: 0.85rem;
          line-height: 1.5;
          &:before {
            content: '#';
            font-size: 0.7em;
            margin-right: 0.1em;
            opacity: 0.7;
            alignment-baseline: middle;
          }
        }
      }
    }
  }

  ol.timeline {
    --axis: 8.5rem;
    list-style: none;
    padding: 0;
    margin: 1.75rem 0;

    li {
      display: grid;
      grid-template-columns: 6.5rem minmax(0, 1fr);
      column-gap: 4rem;
      position: relative;
      margin: 0;
      padding: 0 0 1.5rem;
      line-height: 1.6;

      // line
      &::after {
        content: "";
        position: absolute;
        top: 0.8rem;
        bottom: -0.8rem;
        left: var(--axis);
        border-left: 2px solid var(--fg2);
        transform: translateX(-50%);
      }

      // dot
      &::before {
        content: "";
        position: absolute;
        left: var(--axis);
        top: 0.8rem;
        width: 0.65rem;
        height: 0.65rem;
        border-radius: 50%;
        background: var(--fg1);
        transform: translate(-50%, -50%);
        z-index: 1;
      }

      &.now {
        min-height: calc(1lh + 1.5rem);

        &::before {
          background: #4384f2;
          box-shadow: 0 0 0 3px var(--bg0), 0 0 0 4px #4384f2;
        }
      }

      &.now::after,
      &.future::after {
        border-left-style: dotted;
      }

      &:last-child {
        padding-bottom: 1.5rem;

        &::after {
          bottom: 0;
          mask-image: linear-gradient(to bottom, #000, transparent);
        }
      }

      &:first-child {
        margin-top: 3rem;
        &::after {
          top: -2rem;
          mask-image: linear-gradient(to top, #000, transparent);
        }
      }

      .date {
        text-align: right;
        white-space: nowrap;
        color: var(--fg1);
        font-variant-numeric: tabular-nums;
      }

      .detail {
        font-weight: 500;
        overflow-wrap: anywhere;
      }
    }
    @media (max-width: 500px) {
      --axis: 5.6rem;
      li {
        grid-template-columns: 4.5rem minmax(0, 1fr);
        column-gap: 2.2rem;
        font-size: 0.9rem;
      }
    }

  }

  .works {
    margin-left: auto;
    margin-right: auto;
    place-self: center;

    .works-entry {
      margin: 1.5em 0;

      h3 {
        font-size: 1.3em;
      }

      .description {
        flex-grow: 1;
        ul {
          padding-left: 1.5em;
        }
      }
    }
  }
</style>
